+    //-----------------------------------------------------------------------
+    // Torchlight: the folder's own spelling of `filename`, from a listing taken once, which also
+    // says whether it is there: no stat at all. Every mounted folder is asked for every file the
+    // index does not answer, and on Android's shared storage a stat is a millisecond or more.
+    String FileSystemArchive::resolvePath(const String& filename, int* present) const
+    {
+        String full_path = concatenate_path(mName, filename);
+        if (present)
+            *present = -1;
+#ifdef TL_FILESYSTEM_CASELESS
+        if (filename.empty() || is_absolute_path(filename.c_str()))
+            return full_path;
+        OGRE_LOCK_AUTO_MUTEX;
+        if (!mCaselessListed)
+        {
+            mCaselessListed = true;
+            mExactNames.clear();
+            mCaselessNames.clear();
+            for (bool dirs : {false, true})
+            {
+                StringVector names;
+                findFiles("*", true, dirs, &names, 0);
+                for (const String& name : names)
+                {
+                    mExactNames.insert(name);
+                    String key = name;
+                    StringUtil::toLowerCase(key);
+                    mCaselessNames.emplace(key, name);
+                }
+            }
+        }
+        String key = filename;
+        std::replace(key.begin(), key.end(), '\\', '/');
+        while (key.compare(0, 2, "./") == 0)
+            key.erase(0, 2);
+        if (mExactNames.count(key))
+        {
+            if (present)
+                *present = 1;
+            return concatenate_path(mName, key);
+        }
+        StringUtil::toLowerCase(key);
+        auto found = mCaselessNames.find(key);
+        if (present)
+            *present = found != mCaselessNames.end() ? 1 : 0;
+        if (found != mCaselessNames.end())
+            return concatenate_path(mName, found->second);
+#endif
+        return full_path;
     }
